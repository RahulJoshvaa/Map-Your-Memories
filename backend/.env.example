# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/map_your_memories

# JWT
JWT_SECRET_KEY=your-long-random-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Storage: "local" (files in UPLOAD_DIR), "cloudinary" or "r2" (Cloudflare R2)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

# Cloudinary - dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=map-your-memories

# Cloudflare R2 - dashboard > R2 > Manage API tokens (Object Read & Write on the bucket)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=map-your-memories
# Optional public base URL (r2.dev or custom domain). Leave empty to keep the bucket
# private and serve short-lived presigned URLs instead.
R2_PUBLIC_URL=
R2_URL_EXPIRE_SECONDS=3600

# AI search (Groq) - get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Content search (vector DB). Documents and audio are embedded locally and stored in Qdrant.
CONTENT_INDEXING_ENABLED=true
VECTOR_DB_PATH=./vector_db
# Optional Qdrant server / Qdrant Cloud instead of the local folder
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CONTENT_MIN_SCORE=0.6

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
